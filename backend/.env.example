# Copy this file to backend/.env for local development.
# Never commit real secrets.

# Environment: local, staging, production
APP_ENV=local
DEBUG=false

# Authentication mode for the current middleware.
# Supported values: api_key, disabled
# api_key requires DOCMIND_API_KEY. disabled leaves all API routes unprotected.
AUTH_MODE=api_key
DOCMIND_API_KEY=replace-with-a-random-demo-key

# API docs are enabled by default outside production and disabled by default in production.
API_DOCS_ENABLED=true

# CORS origins. Use "*" for local demos only; use comma-separated origins in deployments.
CORS_ORIGINS=*

# ChromaDB storage. Relative paths resolve from the backend/ directory.
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=docmind_chunks

# Upload settings. Relative paths resolve from the backend/ directory.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_FILE_TYPES=.pdf,.docx,.txt

# LLM provider. GEMINI_API_KEY is used by the active generator/router.
GEMINI_API_KEY=replace-with-your-gemini-key
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_MODEL_NAME=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
PROVIDER_RETRY_COUNT=0

# Embeddings.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_SECONDS=60

# Retrieval defaults.
RETRIEVAL_TOP_K=5
FULL_DOCUMENT_MAX_CHUNKS=25

# Hugging Face Spaces/static frontend serving.
HF_SPACE=false
HF_STATIC_DIR=/home/appuser/backend/static
