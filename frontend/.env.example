VITE_API_BASE_URL=http://localhost:8000

# Optional. Must match backend DOCMIND_API_KEY when backend AUTH_MODE=api_key.
# This value is bundled into browser JavaScript and is visible to users.
# Use it only for personal deployments, internal demos, or externally protected apps.
VITE_DOCMIND_API_KEY=replace-with-demo-api-key
